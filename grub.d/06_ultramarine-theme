#!/bin/sh

. "$pkgdatadir/grub-mkconfig_lib"

case " $GRUB_TERMINAL_OUTPUT " in *" gfxterm "*) ;; *) exit 0 ;; esac

for theme in /boot/grub2/themes/ultramarine-*/theme.txt; do
  [ -f "$theme" ] && break
done
[ -f "$theme" ] || exit 0

case "$GRUB_THEME" in
  ""|*/ultramarine-*) ;;
  *) [ -f "$GRUB_THEME" ] && exit 0 ;;
esac

themedir=$(dirname "$theme")
prepare_grub_to_access_device "$(${grub_probe} --target=device "$theme")"
echo "insmod gfxmenu"
for f in "$themedir"/*.pf2; do
  echo "loadfont (\$root)$(make_system_path_relative_to_its_root "$f")"
done
echo "insmod png"
echo "set theme=(\$root)$(make_system_path_relative_to_its_root "$theme")"
echo "export theme"

echo "insmod gfxterm_background"
sed -n 's/^desktop-color: \("#[0-9a-fA-F]*"\)$/background_color \1/p' "$theme"
